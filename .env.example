# ==============================================================================
# DEV STACK - CONFIGURATION ENVIRONNEMENT
# Copiez ce fichier vers ".env" et modifiez les valeurs si nécessaire.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. PARAMÈTRES GLOBAUX
# Ces paramètres servent de valeur par défaut pour toute la stack.
# ──────────────────────────────────────────────────────────────────────────────

# Mots de passe et identifiants par défaut
GLOBAL_USER=devuser
GLOBAL_PASSWORD=D3vP@ss2025!
GLOBAL_DB_NAME=devdb

# Domaine local (ex: localhost, local, test)
DOMAIN_SUFFIX=local

# Profils à démarrer par défaut (séparés par des virgules)
# Profils disponibles : db, db_tools, devtools, messaging, storage, automation, data
# Laissez vide ou commentez pour lancer via des commandes spécifiques
# COMPOSE_PROFILES=db,devtools,db_tools

# ──────────────────────────────────────────────────────────────────────────────
# 2. SURCHARGES SPÉCIFIQUES (Optionnel)
# Décommentez ces lignes pour utiliser des valeurs différentes pour un service.
# Si une variable est commentée, c'est la valeur globale (ci-dessus) qui s'applique.
# ──────────────────────────────────────────────────────────────────────────────

# -- MySQL --
# MYSQL_USER=custom_mysql_user
# MYSQL_PASSWORD=custom_mysql_password
# MYSQL_ROOT_PASSWORD=custom_root_password
# MYSQL_DATABASE=custom_mysql_db

# -- PostgreSQL --
# POSTGRES_USER=custom_pg_user
# POSTGRES_PASSWORD=custom_pg_password
# POSTGRES_DB=custom_pg_db

# -- MongoDB --
# MONGO_INITDB_ROOT_USERNAME=custom_mongo_user
# MONGO_INITDB_ROOT_PASSWORD=custom_mongo_password
# MONGO_INITDB_DATABASE=custom_mongo_db

# -- Redis --
# REDIS_PASSWORD=custom_redis_password

# -- RabbitMQ --
# RABBITMQ_DEFAULT_USER=custom_rabbit_user
# RABBITMQ_DEFAULT_PASS=custom_rabbit_password
# RABBITMQ_DEFAULT_VHOST=devhost

# -- Soketi --
# SOKETI_DEFAULT_APP_ID=devapp
# SOKETI_DEFAULT_APP_KEY=devkey
# SOKETI_DEFAULT_APP_SECRET=custom_soketi_secret

# -- MinIO --
# MINIO_ROOT_USER=custom_minio_user
# MINIO_ROOT_PASSWORD=custom_minio_password

# -- n8n --
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=custom_n8n_password
# N8N_DB_POSTGRESDB_USER=custom_n8n_db_user
# N8N_DB_POSTGRESDB_PASSWORD=custom_n8n_db_password

# -- Jupyter --
# JUPYTER_TOKEN=custom_jupyter_token

# -- Outils DB (phpMyAdmin, pgAdmin, Mongo Express) --
# PMA_USER=root
# PMA_PASSWORD=custom_pma_password
# PGADMIN_DEFAULT_EMAIL=dev@local.dev
# PGADMIN_DEFAULT_PASSWORD=custom_pgadmin_password
# ME_CONFIG_BASICAUTH_USERNAME=admin
# ME_CONFIG_BASICAUTH_PASSWORD=custom_me_password
