# ==============================================================================
# DEV STACK - CONFIGURATION ENVIRONNEMENT
# Copiez ce fichier vers ".env" et modifiez les valeurs si nécessaire.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. PARAMÈTRES GLOBAUX & COMMONS
# Ces paramètres servent de valeur par défaut pour toute la stack.
# ──────────────────────────────────────────────────────────────────────────────

# Mots de passe et identifiants par défaut
GLOBAL_USER=
GLOBAL_PASSWORD=
GLOBAL_DB_NAME=

# Domaine local (ex: localhost, local, me)
DOMAIN_SUFFIX=local

# Fuseau horaire / Locale (ex: Europe/Paris, Africa/Porto-Novo)
TIMEZONE=Africa/Porto-Novo

# Profils Compose à démarrer par défaut (séparés par des virgules)
# Profils disponibles : 
#   - Bases de données : db (global), db_postgres, db_mysql, db_redis, db_mongo
#   - Admin BDD         : db_tools
#   - Passerelle IA     : ai
#   - Ops & Docker      : ops, observability
#   - Bureau & Schémas  : office, diagram
#   - Outils Dev & API  : api_tools, devtools
#   - Autres            : messaging, storage, automation, data, search, code_quality, osint, sync
# COMPOSE_PROFILES=db,db_tools,ops,ai,messaging,storage,api_tools,office,sync,code_quality


# ──────────────────────────────────────────────────────────────────────────────
# 2. BASES DE DONNÉES & CACHE (Profil: db)
# ──────────────────────────────────────────────────────────────────────────────

# -- PostgreSQL --
# POSTGRES_IMAGE=dasero197/postgres-semver:17.9
# POSTGRES_USER=custom_pg_user
# POSTGRES_PASSWORD=custom_pg_password
# POSTGRES_DB=custom_pg_db

# -- MySQL / MariaDB --
# MYSQL_USER=custom_mysql_user
# MYSQL_PASSWORD=custom_mysql_password
# MYSQL_ROOT_PASSWORD=custom_root_password
# MYSQL_DATABASE=custom_mysql_db

# -- MongoDB --
# MONGO_INITDB_ROOT_USERNAME=custom_mongo_user
# MONGO_INITDB_ROOT_PASSWORD=custom_mongo_password
# MONGO_INITDB_DATABASE=custom_mongo_db

# -- Redis --
# REDIS_PASSWORD=custom_redis_password


# ──────────────────────────────────────────────────────────────────────────────
# 3. OUTILS DE GESTION BD (Profil: db_tools)
# ──────────────────────────────────────────────────────────────────────────────

# -- phpMyAdmin --
# PMA_USER=root
# PMA_PASSWORD=custom_pma_password

# -- pgAdmin --
# PGADMIN_DEFAULT_EMAIL=dev@local.dev
# PGADMIN_DEFAULT_PASSWORD=custom_pgadmin_password

# -- Mongo Express --
# ME_CONFIG_BASICAUTH_USERNAME=admin
# ME_CONFIG_BASICAUTH_PASSWORD=custom_me_password


# ──────────────────────────────────────────────────────────────────────────────
# 4. MESSAGERIE & EVENT BUS (Profil: messaging)
# ──────────────────────────────────────────────────────────────────────────────

# -- RabbitMQ --
# RABBITMQ_DEFAULT_USER=custom_rabbit_user
# RABBITMQ_DEFAULT_PASS=custom_rabbit_password
# RABBITMQ_DEFAULT_VHOST=devhost

# -- Soketi (WebSockets) --
# SOKETI_DEFAULT_APP_ID=devapp
# SOKETI_DEFAULT_APP_KEY=devkey
# SOKETI_DEFAULT_APP_SECRET=custom_soketi_secret


# ──────────────────────────────────────────────────────────────────────────────
# 5. STOCKAGE D'OBJETS & FILES (Profil: storage)
# ──────────────────────────────────────────────────────────────────────────────

# -- MinIO --
# MINIO_ROOT_USER=custom_minio_user
# MINIO_ROOT_PASSWORD=custom_minio_password


# ──────────────────────────────────────────────────────────────────────────────
# 6. AUTOMATISATION & WORKFLOWS (Profil: automation)
# ──────────────────────────────────────────────────────────────────────────────

# -- n8n --
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=custom_n8n_password
# N8N_DB_POSTGRESDB_USER=custom_n8n_db_user
# N8N_DB_POSTGRESDB_PASSWORD=custom_n8n_db_password


# ──────────────────────────────────────────────────────────────────────────────
# 7. DATA SCIENCE (Profil: data)
# ──────────────────────────────────────────────────────────────────────────────

# -- JupyterLab --
# JUPYTER_TOKEN=custom_jupyter_token


# ──────────────────────────────────────────────────────────────────────────────
# 8. OUTILS API & TEST (Profil: api_tools)
# ──────────────────────────────────────────────────────────────────────────────

# -- Hoppscotch --
# ⚠️ Attention : Changez absolument ces valeurs en production pour sécuriser vos données !
# HOPPSCOTCH_ENCRYPTION_KEY=01234567890123456789012345678901
# HOPPSCOTCH_JWT_SECRET=devstack-secret-key-change-me-in-production
# HOPPSCOTCH_SESSION_SECRET=devstack-secret-key-change-me-in-production


# ──────────────────────────────────────────────────────────────────────────────
# 9. MOTEUR DE RECHERCHE (Profil: search)
# ──────────────────────────────────────────────────────────────────────────────

# -- Meilisearch --
# MEILI_MASTER_KEY=custom_meili_key


# ──────────────────────────────────────────────────────────────────────────────
# 10. QUALITÉ DE CODE (Profil: code_quality)
# ──────────────────────────────────────────────────────────────────────────────

# SonarQube utilise par défaut les identifiants PostgreSQL (POSTGRES_USER / POSTGRES_PASSWORD).


# ──────────────────────────────────────────────────────────────────────────────
# 11. OSINT & CYBERSÉCURITÉ (Profil: osint)
# ──────────────────────────────────────────────────────────────────────────────

# -- Flowsint & Neo4j --
# FLOWSINT_VERSION=latest
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=flowsint_neo4j_password
# ⚠️ Attention : Changez absolument ces clés en production !
# Générer avec : openssl rand -hex 32
# FLOWSINT_AUTH_SECRET=flowsint-auth-secret-change-me-in-prod
# Générer avec : python3 -c "import os, base64; print('base64:' + base64.b64encode(os.urandom(32)).decode())"
# FLOWSINT_MASTER_VAULT_KEY=base64:qnHTmwYb+uoygIw9MsRMY22vS5YPchY+QOi/E79GAvM=


# ──────────────────────────────────────────────────────────────────────────────
# 12. SYNCHRONISATION & VAULTS (Profil: sync)
# ──────────────────────────────────────────────────────────────────────────────

# -- Syncthing --
# PUID=1000
# PGID=1000
# SYNCTHING_SYNC_DIR=~/Documents/Vaults_Clients


# ──────────────────────────────────────────────────────────────────────────────
# 13. OUTILS DE DÉVELOPPEMENT & IA (Profil: devtools)
# ──────────────────────────────────────────────────────────────────────────────

# -- Excalidraw (Tableau blanc collaboratif) --
# EXCALIDRAW_BACKEND_V2_SERVER=
# EXCALIDRAW_SOCKET_SERVER_URL=
# EXCALIDRAW_DISABLE_TRACKING=true

# -- OmniRoute (IA Gateway) --
# ⚠️ Attention : Générer des clés sécurisées en production (ex: openssl rand -hex 32 / 16)
# OMNIROUTE_JWT_SECRET=devstack-omniroute-jwt-secret-change-me
# OMNIROUTE_API_KEY_SECRET=devstack-omniroute-api-key-secret-change-me
# OMNIROUTE_STORAGE_ENCRYPTION_KEY=01234567890123456789012345678901
# OMNIROUTE_INITIAL_PASSWORD=


# ──────────────────────────────────────────────────────────────────────────────
# 14. BUREAUTIQUE & DOCUMENTS (Profil: office)
# ──────────────────────────────────────────────────────────────────────────────

# -- Stirling-PDF --
# STIRLING_PDF_LANGS=fr-FR
# STIRLING_PDF_SECURITY_ENABLE_LOGIN=false
# STIRLING_PDF_APP_NAME=Stirling PDF

# -- Reactive Resume --
# REACTIVE_RESUME_AUTH_SECRET=devstack-reactive-resume-secret-key-change-me
# REACTIVE_RESUME_AI_ENCRYPTION_SECRET=devstack-reactive-resume-secret-key-change-me
