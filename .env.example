# ==============================================================================
# DEV STACK - CONFIGURATION ENVIRONNEMENT
# Copiez ce fichier vers ".env" et modifiez les valeurs si nécessaire.
# Exemple (choisissez la commande adaptée à votre système) :
# POSIX (Linux / macOS / WSL / Git Bash):
#   cp .env.example .env
# PowerShell (Windows / PowerShell Core):
#   Copy-Item .env.example .env
# Python fallback (si Python installé):
#   python - <<'PY'\n#   import shutil\n#   shutil.copyfile('.env.example', '.env')\n#   PY
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. PARAMÈTRES GLOBAUX & COMMONS
# Ces paramètres servent de valeur par défaut pour toute la stack.
# ──────────────────────────────────────────────────────────────────────────────

# Mots de passe et identifiants par défaut
GLOBAL_USER=
GLOBAL_PASSWORD=
GLOBAL_DB_NAME=

# Domaine local (ex: localhost, local, me)
DOMAIN_SUFFIX=local

# Fuseau horaire / Locale (ex: Europe/Paris, Africa/Porto-Novo)
TIMEZONE=Africa/Porto-Novo

# Profils Compose à démarrer par défaut (séparés par des virgules)
# Profils disponibles (catégories) :
#   core         (homepage, traefik — services permanents, sans profil)
#   db           (postgres, mysql, redis, mongo)
#   db_tools     (phpmyadmin, pgadmin, mongo_express, adminer)
#   ai           (omniroute)
#   ops          (portainer, dozzle, glances)
#   office       (stirling_pdf, reactive_resume, excalidraw)
#   api_tools    (hoppscotch, swagger_editor, prism_mock, jsonjoy_builder)
#   messaging    (mailpit, rabbitmq, soketi)
#   storage      (minio)
#   automation   (n8n)
#   data         (jupyter)
#   search       (meilisearch)
#   code_quality (sonarqube)
#   osint        (Flowsint — utiliser le profil individuel `flowsint` pour démarrer l'ensemble Flowsint)
#   sync         (syncthing)
#   autobackup   (sauvegarde automatique des volumes)
#
# Profils individuels (démarrent un service précis) :
#   mysql, postgres, redis, mongo,
#   mailpit, rabbitmq, soketi,
#   hoppscotch, swagger_editor, prism_mock, jsonjoy_builder,
#   phpmyadmin, pgadmin, mongo_express, adminer,
#   stirling_pdf, excalidraw, reactive_resume,
#   portainer, dozzle, glances,
#   flowsint,
#   meilisearch, minio, syncthing, jupyter, sonarqube
#
# NOTE : Les services de bases de données incluent désormais les profils des services qui en dépendent,
# afin que le lancement d'un profil individuel démarre automatiquement la base nécessaire.
# Exemples :
#   postgres -> hoppscotch, n8n, pgadmin, reactive_resume, sonarqube, flowsint
#   mysql    -> phpmyadmin, adminer
#   redis    -> omniroute, reactive_resume, flowsint
#   mongo    -> mongo_express
#
# Configurez ci-dessous les profils que vous utilisez quotidiennement :
# COMPOSE_PROFILES=autobackup,db,db_tools,ops,ai,messaging,storage,api_tools,office,sync,code_quality

# ──────────────────────────────────────────────────────────────────────────────
# 1b. SAUVEGARDE AUTOMATIQUE DES VOLUMES (Profil: autobackup)
#
# Ajoutez "autobackup" à COMPOSE_PROFILES pour l'activer. Les volumes de la
# stack sont montés automatiquement par internal/composes/backups.yml.
# Pour le désactiver, retirez simplement "autobackup" de COMPOSE_PROFILES.
# ──────────────────────────────────────────────────────────────────────────────

# Planification, archive et compression
BACKUP_CRON_EXPRESSION=@daily
BACKUP_JITTER=0s
BACKUP_COMPRESSION=zst
GZIP_PARALLELISM=1
BACKUP_FILENAME=devstack-%Y-%m-%dT%H-%M-%S.{{ .Extension }}
BACKUP_FILENAME_EXPAND=false
#BACKUP_LATEST_SYMLINK=
# Option dépréciée, conservée uniquement pour compatibilité avec d’anciennes configurations
#BACKUP_FROM_SNAPSHOT=false
#BACKUP_SOURCES=/backup
#BACKUP_EXCLUDE_REGEXP=

# Destination locale par défaut: ./backups (ignorée par Git)
BACKUP_ARCHIVE=/archive

# Rétention et nettoyage
BACKUP_RETENTION_DAYS=7
BACKUP_PRUNING_LEEWAY=1m
BACKUP_PRUNING_PREFIX=devstack-
BACKUP_SKIP_BACKENDS_FROM_PRUNE=

# S3 ou stockage compatible S3. Laisser AWS_S3_BUCKET_NAME vide pour désactiver.
# AWS_S3_BUCKET_NAME=
# AWS_S3_PATH=devstack
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_IAM_ROLE_ENDPOINT=
# AWS_ENDPOINT=s3.amazonaws.com
# AWS_ENDPOINT_PROTO=https
# AWS_ENDPOINT_INSECURE=false
# AWS_ENDPOINT_CA_CERT=
# AWS_STORAGE_CLASS=
# AWS_PART_SIZE=16

# WebDAV (laisser WEBDAV_URL vide pour désactiver)
# WEBDAV_URL=
# WEBDAV_PATH=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_URL_INSECURE=false

# SSH/SFTP (laisser SSH_HOST_NAME vide pour désactiver)
# SSH_HOST_NAME=
# SSH_PORT=22
# SSH_REMOTE_PATH=
# SSH_USER=
# SSH_PASSWORD=
# SSH_IDENTITY_FILE=/root/.ssh/id_rsa
# SSH_IDENTITY_PASSPHRASE=

# Azure Blob Storage (laisser AZURE_STORAGE_CONTAINER_NAME vide pour désactiver)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_PRIMARY_ACCOUNT_KEY=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=
# AZURE_STORAGE_ENDPOINT=https://{{ .AccountName }}.blob.core.windows.net/
# AZURE_STORAGE_ACCESS_TIER=

# Dropbox (laisser DROPBOX_REMOTE_PATH vide pour désactiver)
# DROPBOX_REMOTE_PATH=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_CONCURRENCY_LEVEL=6
# DROPBOX_REFRESH_TOKEN=

# Google Drive (laisser GOOGLE_DRIVE_FOLDER_ID vide pour désactiver)
# GOOGLE_DRIVE_CREDENTIALS_JSON=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_TEAM_DRIVE_ID=
# GOOGLE_DRIVE_IMPERSONATE_SUBJECT=
# GOOGLE_DRIVE_ENDPOINT=
# GOOGLE_DRIVE_TOKEN_URL=

# Chiffrement: configurer une seule méthode si nécessaire
# GPG_PASSPHRASE=
# GPG_PUBLIC_KEY_RING=
# AGE_PASSPHRASE=
# AGE_PUBLIC_KEYS=

# Arrêt des conteneurs et commandes de cycle de vie
BACKUP_STOP_DURING_BACKUP_LABEL=true
BACKUP_STOP_DURING_BACKUP_NO_RESTART_LABEL=true
BACKUP_STOP_SERVICE_TIMEOUT=5m
EXEC_FORWARD_OUTPUT=false
# EXEC_LABEL=

# Notifications Shoutrrr, par exemple: smtp://user:password@host:587/?toAddresses=dev@example.com
# NOTIFICATION_URLS=
# NOTIFICATION_LEVEL=error

# Docker, verrouillage et fuseau horaire
# DOCKER_HOST=
# LOCK_TIMEOUT=60m

# Anciennes notifications email, conservées pour compatibilité
# EMAIL_NOTIFICATION_RECIPIENT=
# EMAIL_NOTIFICATION_SENDER=noreply@nohost
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PORT=587


